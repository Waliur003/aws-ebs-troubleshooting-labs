{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseSpecificEBSKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:Decrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": ""
    },
    {
      "Sid": "AllowGrantForAWSResource",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    }
  ]
}
